{
  "name": "@local/dsh-update-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Blocks the desktop update path until installed plugins have been checked, repaired and staged against the target DeepSeek Harness release.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dandandujie/My-Plugins.git",
    "directory": "dsh-update-guard"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
